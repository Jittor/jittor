#: 780cecafae804832a7fd77c0e6f63441
msgid "Probability distributions API"
msgstr "概率分布 API"

#: 0cf3a34d405f4de8b22455f0c0576d7c
msgid ""
"torch.distributions.Bernoulli. NB: for Bernoulli the logits->probs map IS"
" sigmoid (unlike Categorical, where it is softmax -- see the Categorical "
"fix)."
msgstr ""

#: c6467b887e3844f090a38b5e7cf97d58
msgid "torch.distributions.Beta(concentration1, concentration0)."
msgstr ""

#: a0aeda7dc6f845408b107e4e6700394d
msgid "torch.distributions.Dirichlet(concentration) -- last-dim parameter vector."
msgstr ""

#: 469bfa7cd53e4148b0009f3c90c93962
msgid ""
"Minimal base class for torch.distributions.Distribution (used for "
"isinstance checks and as a common interface)."
msgstr ""

#: 96f0d551532b4ee38c9ca55160dfcf7d
msgid ""
"torch.distributions.Gamma(concentration, rate) -- shape/rate "
"parameterization. (The pre-existing GammaDistribution is kept for "
"backward-compat; this adds entropy, torch-flexible Var args, and stays "
"differentiable.)"
msgstr ""

#: 5c6e50a1648842cebf5c97414be267eb
msgid ""
"torch.distributions.Independent: reinterpret the last "
"`reinterpreted_batch_ndims` batch dims of `base_distribution` as event "
"dims, i.e. sum log_prob/entropy over them. Common in RL continuous "
"control: Independent(Normal(mu, sigma), 1)."
msgstr ""

#: e5e1b51a2ef141fba141c7f2d3d1dda6
msgid ""
"torch.distributions.Poisson(rate). NB: torch defines no closed-form "
"entropy (neither do we); sampling is non-reparameterizable (numpy "
"poisson)."
msgstr ""
