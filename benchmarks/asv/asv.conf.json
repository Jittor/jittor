{
  "version": 1,
  "project": "Jittor",
  "project_url": "https://cg.cs.tsinghua.edu.cn/jittor/",
  "repo": "../..",
  "branches": [
    "HEAD"
  ],
  "show_commit_url": "https://github.com/Jittor/jittor/commit/",
  "environment_type": "existing",
  "pythons": [
    "same"
  ],
  "benchmark_dir": ".",
  "env_dir": "../../../jittor-lab/_state/asv/env",
  "results_dir": "../../../jittor-lab/_state/asv/results",
  "html_dir": "../../../jittor-lab/_state/asv/html",
  "build_cache_size": 0,
  "default_benchmark_timeout": 300,
  "launch_method": "spawn",
  "regressions_thresholds": {
    "operators.*": 0.1,
    "convolution.*": 0.15,
    "tiny_llama.*": 0.15,
    "optimizer_step.*": 0.15,
    "transfer.time_*": 0.15,
    "transfer.track_device_to_host_peak_ratio": 0.05,
    "reductions.*": 0.15
  }
}
