# Canonical Stage 2 CI and container baseline. Keep every value on one shell-safe line.
CI_HOST_RUNNER=ubuntu-24.04
CI_PYTHON_VERSION=3.11
CI_CPU_CI_IMAGE=ubuntu:24.04
CI_CUDA_VERSION=12.2
CI_CUDA_RUNNER_LABELS='["self-hosted","linux","x64","jittor-ci","cuda12-2","rtx4090"]'
CI_NPU_RUNNER_LABELS='["self-hosted","linux","ARM64","jittor-ci","cann9","ascend910b"]'
CI_CONTAINER_MATRIX='{"include":[{"name":"CPU","image":"jittor","base":"ubuntu:24.04"},{"name":"CUDA 12.2","image":"jittor-cuda","base":"nvidia/cuda:12.2.2-cudnn8-devel-ubuntu22.04"}]}'
CI_RELEASE_PLATFORM_MATRIX='{"include":[{"os":"ubuntu-24.04","identifier":"cp311-manylinux_x86_64"},{"os":"macos-15-intel","identifier":"cp311-macosx_x86_64"},{"os":"windows-2022","identifier":"cp311-win_amd64"}]}'
