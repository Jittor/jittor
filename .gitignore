# Local editor and operating-system state.
/.refresh
/.vscode/
.DS_Store
*.swp
.ipynb_checkpoints/

# Python caches, environments, coverage, and package artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.asv/
.tox/
.nox/
.coverage
htmlcov/
build/
# This is a source-owned tool category, not a generated build directory.
!/tools/build/
!/tools/build/**
dist/
venv/
.venv/
*.whl

# Generated archives, binaries, notebooks, and local profiling output.
*.ipynb
!/examples/notebooks/**/*.ipynb
*.pdf
*.zip
*.tgz
*.obj
/my
/__res/
/perf.data
/perf.data.old
/data/
extern/mkl/mkldnn_lnx*/*

# Agent deliverables are Markdown; transient state and other generated files stay
# outside the repository or under the ignored worklog/cache paths below.
/agent/*
!/agent/README.md
!/agent/manuals/
!/agent/manuals/**/
!/agent/manuals/**/*.md
!/agent/results/
/agent/results/**
!/agent/results/**/
!/agent/results/**/*.md
!/agent/scripts/
/agent/scripts/**
!/agent/scripts/*.sh
!/agent/scripts/*.py
!/agent/baselines/
!/agent/baselines/**
!/agent/skills/
!/agent/skills/**
/agent/skills/**/.cache/
/agent/skills/**/__pycache__/
/agent/worklogs/

# Large experiments and runtime state belong in ../jittor-lab. Do not ignore
# repository-root copies by project name: layout checks should expose them.
/core
/__data__/
