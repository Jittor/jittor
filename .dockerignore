# The image is built from the Python package and versioned examples. A
# default-deny context keeps local experiments, worktrees, caches and raw results
# out even when they use a name that has not appeared in this repository before.
**
!setup.py
!pyproject.toml
!README.md
!MANIFEST.in
!LICENSE.txt
!python/
!python/**
!src/
!src/**
!backends/
!backends/**
!requirements/
!requirements/examples.txt
!examples/
!examples/**
examples/**/__pycache__/
examples/**/.pytest_cache/
examples/**/.ipynb_checkpoints/
examples/**/*.ipynb
src/**/__pycache__/
src/**/.pytest_cache/
src/**/.mypy_cache/
src/**/.ruff_cache/
src/**/.ipynb_checkpoints/
src/**/*.py[cod]
src/**/*.log
backends/**/__pycache__/
backends/**/.pytest_cache/
backends/**/.mypy_cache/
backends/**/.ruff_cache/
backends/**/.ipynb_checkpoints/
backends/**/*.py[cod]
backends/**/*.log
