# Runtime resources consumed by Jittor's compiler and compatibility shims.
# Regular Python packages are included by package discovery; these declarations
# cover runtime files it cannot discover and intentionally avoid catch-alls.
include python/jittor/__init__.pyi
recursive-include python/jittor/compat/shim/cpp_extension/include *
recursive-include python/jittor/compat/shim/cpp_extension/src *
recursive-include python/jittor/compat/shim/resources *
recursive-include python/jittor/extern *
recursive-include python/jittor/math_util/src *
recursive-include python/jittor/src *
recursive-include python/jittor/utils *.py
include python/jittor/utils/data.gz
recursive-include python/jittor_utils/class *

# Repository examples and tools ship in the sdist, but package discovery remains under python/.
recursive-include examples *
recursive-include tools *
recursive-include docs *
include requirements/examples.txt
include requirements/docs.in
include requirements/docs.txt

global-exclude *.py[cod]
global-exclude *.ipynb
global-exclude __pycache__
global-exclude .DS_Store
prune python/jittor/**/__pycache__
prune python/jittor_utils/**/__pycache__
prune python/jittor/**/.pytest_cache
prune python/jittor_utils/**/.pytest_cache
prune python/jittor/**/__data__
prune python/jittor_utils/**/__data__
prune examples/**/__pycache__
prune examples/**/.pytest_cache
prune examples/**/.ipynb_checkpoints
prune tools/**/__pycache__
prune tools/**/.pytest_cache
prune docs/**/__pycache__
prune docs/**/.doctrees
prune docs/**/_build
